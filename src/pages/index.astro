---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/elements/PageHeader.astro";
import BlogSection from "@/components/sections/BlogSection.astro";

const POSTS_PER_PAGE = 6;
const currentPage = 1;
---

<Layout title="脆骨的测试空间 — RicoFast｜NAS/Docker/群晖技术笔记" description="脆骨的测试空间（RicoFast）是一个专注 NAS、Docker、群晖 Synology、Linux 运维与自托管技术的个人博客。分享群晖 NAS 装 pip、Docker 容器自启动、阿里云 DDNS、CentOS 镜像源替换等保姆级实战教程与排错经验，也记录猫咪与生活的日常。">
  <section class="relative z-20 container mx-auto my-12 px-7 lg:px-0">
    <PageHeader
      level={1}
      title="脆骨的测试空间"
      description="脆骨的测试空间（RicoFast）是一个专注 NAS、Docker、群晖 Synology、Linux 运维与自托管技术的个人博客。分享群晖 NAS 装 pip、Docker 容器自启动、阿里云 DDNS、CentOS 镜像源替换等保姆级实战教程与排错经验，也记录猫咪与生活的日常。"
    />
  </section>
  <section class="relative z-20 mx-auto my-12 lg:px-0">
    <div class="mt-12">
      <BlogSection
        title=""
        listPage={true}
        pagination={{
          enable: true,
          currentPage: currentPage
        }}
        postsPerPage={POSTS_PER_PAGE}
      />
    </div>
  </section>
</Layout>
