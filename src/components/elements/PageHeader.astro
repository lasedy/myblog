---
import AnimatedText from "@/components/ui/AnimatedText.astro";
interface Props {
	title?: string ;
	description?: string ;
	tags?: string[] ;
  className?: string ;
}

const { title, description, tags = [], className = "" } = Astro.props;
---

<div class={`relative z-20 w-full mx-auto mt-16 mb-16 text-center ${className}`}>
  <!-- 背景图（高度 x2.25：在 1.5 倍基础上再 +50%，上下各扩展 62.5%） -->
  <div
    class="pointer-events-none absolute left-0 right-0 top-[-62.5%] bottom-[-62.5%] -z-10 bg-cover bg-center"
    style="background-image: url('/assets/category-best.jpg');"
  ></div>
  <h2
    class="text-4xl font-brand font-bold text-center tracking-normal text-white sm:text-4xl lg:text-5xl drop-shadow-lg"
  >
  {title && <AnimatedText delay={0.2} stagger={0.08} content={title} />}
  </h2>
  {description && (
    <div
      class="mt-3 text-sm font-semibold leading-6 text-white sm:mt-4 lg:mt-6 sm:leading-7 lg:leading-8 sm:text-base lg:text-lg max-w-full lg:max-w-2xl m-auto drop-shadow-lg"
    >
      <AnimatedText delay={0.6} stagger={0.03} duration={1}  content={description} />
    </div>
  )}

  {tags && tags.length > 0 && (
    <div class="flex flex-wrap justify-center gap-2 mt-12 mb-2 ">
      {tags.map((tag) => (
        <span class="inline-flex items-center rounded-full bg-white/20 px-3 py-1 text-[11px] font-semibold text-white border border-white/40 tracking-wide drop-shadow-lg">
          {tag}
        </span>
      ))}
    </div>
  )}
  

</div>