---
import { getCollection } from "astro:content";

// 收集全部文章，构建轻量搜索索引（标题 / 简介 / 标签 / 链接）
const allPosts = await getCollection("post");
const posts = allPosts
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .map((p) => ({
    title: p.data.title,
    description: p.data.description,
    tags: p.data.tags ?? [],
    url: `/blog/${p.id}`,
    date: p.data.publishDate.toISOString().slice(0, 10),
  }));

// 转义 < 防止 JSON 中文字符串意外闭合 script 标签
const postsJson = JSON.stringify(posts).replace(/</g, "\\u003c");
---

<div class="blog-search relative z-30 my-8" data-blog-search>
  <div class="relative max-w-md">
    <svg
      class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-neutral-400"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="11" cy="11" r="8"></circle>
      <path d="m21 21-4.3-4.3"></path>
    </svg>
    <input
      type="search"
      id="blog-search-input"
      placeholder="搜索文章标题、简介或标签…"
      aria-label="搜索文章"
      class="w-full rounded-xl border border-neutral-200 bg-white py-2.5 pl-9 pr-4 text-sm text-neutral-800 placeholder-neutral-400 outline-none transition focus:border-neutral-400 dark:border-neutral-700 dark:bg-neutral-900 dark:text-white"
      autocomplete="off"
    />
    <ul
      id="blog-search-results"
      class="absolute left-0 right-0 z-40 mt-2 hidden space-y-2 rounded-xl border border-neutral-200 bg-white p-2 shadow-lg dark:border-neutral-700 dark:bg-neutral-900"
    ></ul>
  </div>
</div>

<script type="application/json" id="blog-search-data" set:html={postsJson}></script>

<script>
  const root = document.querySelector<HTMLElement>("[data-blog-search]");
  if (root) {
    const input = root.querySelector<HTMLInputElement>("#blog-search-input")!;
    const results = root.querySelector<HTMLUListElement>("#blog-search-results")!;
    const dataEl = document.getElementById("blog-search-data") as HTMLScriptElement | null;
    const posts: Array<{ title: string; description: string; tags: string[]; url: string; date: string }> = dataEl
      ? JSON.parse(dataEl.textContent || "[]")
      : [];

    function escapeHtml(s: string): string {
      return s.replace(/[&<>"']/g, (c) => {
        const map: Record<string, string> = { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" };
        return map[c] ?? c;
      });
    }

    function render(q: string) {
      const query = q.trim().toLowerCase();
      if (!query) {
        results.classList.add("hidden");
        results.innerHTML = "";
        return;
      }
      const matched = posts
        .filter((p) =>
          (p.title + " " + p.description + " " + p.tags.join(" ")).toLowerCase().includes(query)
        )
        .slice(0, 8);

      if (!matched.length) {
        results.innerHTML = `<li class="px-3 py-2 text-sm text-neutral-500 dark:text-neutral-400">未找到相关文章</li>`;
      } else {
        results.innerHTML = matched
          .map(
            (p) => `
          <li>
            <a href="${p.url}" class="block rounded-lg px-3 py-2 hover:bg-neutral-100 dark:hover:bg-neutral-800">
              <div class="text-sm font-medium text-neutral-800 dark:text-white">${escapeHtml(p.title)}</div>
              <div class="mt-0.5 truncate text-xs text-neutral-500 dark:text-neutral-400">${escapeHtml(p.description)}</div>
            </a>
          </li>`
          )
          .join("");
      }
      results.classList.remove("hidden");
    }

    input.addEventListener("input", (e) => render((e.target as HTMLInputElement).value));
    input.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        input.value = "";
        render("");
      }
    });
    document.addEventListener("click", (e) => {
      if (!root.contains(e.target as Node)) results.classList.add("hidden");
    });
  }
</script>
